# ============================================================
# GoViral Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ─── Server ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_URL=https://api.goviral.app          # Your deployed backend URL
IOS_APP_URL=goviral://social/callback   # iOS deep link callback

# ─── Database ────────────────────────────────────────────────
DATABASE_URL="mysql://username:password@hostname:3306/database_name"

# ─── Redis (for Bull job queue) ───────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Token Encryption ────────────────────────────────────────
# 32-byte (256-bit) hex key for AES-256 token encryption
TOKEN_ENCRYPTION_KEY="your-32-byte-hex-encryption-key-here"

# ─── JWT Auth ────────────────────────────────────────────────
JWT_SECRET="your-jwt-secret-here"

# ─── Instagram / Meta ────────────────────────────────────────
# https://developers.facebook.com/apps/
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
INSTAGRAM_REDIRECT_URI="https://api.goviral.app/api/social/instagram/callback"

# ─── TikTok ──────────────────────────────────────────────────
# https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="https://api.goviral.app/api/social/tiktok/callback"

# ─── YouTube / Google ────────────────────────────────────────
# https://console.cloud.google.com/
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI="https://api.goviral.app/api/social/youtube/callback"

# ─── LinkedIn ────────────────────────────────────────────────
# https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="https://api.goviral.app/api/social/linkedin/callback"
